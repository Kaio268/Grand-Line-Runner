			NormalCrewSlots = 4,
			CaptainSlotUnlocked = false,
			CaptainState = "inactive",
			CaptainBonusPercent = 0,
			UpgradeRewardLabel = "Lvl 1 Ship with 4 normal crew slots",
		},
