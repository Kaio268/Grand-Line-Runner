		textColor = Color3.fromRGB(191, 255, 247),
		borderColor = Color3.fromRGB(96, 240, 209),
		glowColor = Color3.fromRGB(143, 255, 227),
		gradientStart = Color3.fromRGB(214, 255, 247),
		gradientEnd = Color3.fromRGB(73, 206, 182),
		strokeThickness = 1.72,
		hoverStrokeThickness = 1.96,
