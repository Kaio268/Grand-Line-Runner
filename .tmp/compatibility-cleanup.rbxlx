        <Item class="ModuleScript" referent="171">
          <Properties>
            <string name="Name">HieClient</string>
            <string name="Source"><![CDATA[return require(script.Parent:WaitForChild("Hie"):WaitForChild("Client"):WaitForChild("HieClient"))
]]></string>
