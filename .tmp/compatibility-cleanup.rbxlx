	end,

	[3516543186] = function(receiptInfo, player, profile, DataManager: Types.DataManager)
		if DataManager:GetValue(player, "Gears.Lava SpeedCoil") then
			DataManager:SetValue(player, "Gears.Lava SpeedCoil", true)
		else
