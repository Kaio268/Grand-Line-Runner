			Result = result,
		}
		print(string.format(
			"%s income-toast-helper item=%s value=%s canonical=%s fallback=%s legacy=%s canonicalValue=%s authoritative=%s legacyIdentity=%s validationAge=%.1fs",
			LOG_PREFIX,
			tostring(storageName or ""),
