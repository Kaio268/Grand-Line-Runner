]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="191">
          <Properties>
            <string name="Name">MeraAssetCatalog</string>
            <string name="Source"><![CDATA[return require(script.Parent:WaitForChild("Mera"):WaitForChild("Shared"):WaitForChild("MeraAssetCatalog"))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="192">
          <Properties>
            <string name="Name">MeraDashClient</string>
            <string name="Source"><![CDATA[return require(script.Parent:WaitForChild("Mera"):WaitForChild("Client"):WaitForChild("MeraDashClient"))
]]></string>
          </Properties>
        </Item>
