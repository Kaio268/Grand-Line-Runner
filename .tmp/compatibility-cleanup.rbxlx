			TextColor3 = buttonTextColor,
			TextSize = 14,
			Font = Theme.Fonts.Display,
			[React.Event.Activated] = function()
				if claimable and props.onClaim then
					props.onClaim(quest.category, quest.id)
				end
			end,
		}, {
			Corner = e("UICorner", {
				CornerRadius = UDim.new(0, 12),
