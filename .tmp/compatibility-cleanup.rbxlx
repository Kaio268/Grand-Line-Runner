	if interactive then
		itemProps.AutoButtonColor = false
		itemProps.Text = ""
		itemProps[React.Event.Activated] = function()
			props.onActivated(item)
		end
	end

	local previewChild = renderItemPreview(item, {
		position = UDim2.fromScale(0.5, 0.5),
