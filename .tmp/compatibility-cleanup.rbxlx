        <Item class="ModuleScript" referent="172">
          <Properties>
            <string name="Name">HieVfx</string>
            <string name="Source"><![CDATA[return require(script.Parent:WaitForChild("Hie"):WaitForChild("Shared"):WaitForChild("Vfx"))
]]></string>
