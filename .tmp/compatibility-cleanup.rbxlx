		gradientStart = Color3.fromRGB(120, 242, 171),
		gradientEnd = Color3.fromRGB(64, 156, 105),
		strokeThickness = 1.14,
		hoverStrokeThickness = 1.28,
		strokeTransparency = 0.14,
		hoverStrokeTransparency = 0.06,
		glowTransparency = 1,
		hoverGlowTransparency = 1,
		sheenTopTransparency = 1,
		hoverSheenTopTransparency = 1,
	}),
	Rare = makeRarityStyle({
		textColor = Color3.fromRGB(176, 220, 255),
		borderColor = Color3.fromRGB(90, 172, 255),
		glowColor = Color3.fromRGB(118, 202, 255),
		gradientStart = Color3.fromRGB(151, 214, 255),
		gradientEnd = Color3.fromRGB(77, 140, 221),
		strokeThickness = 1.24,
		hoverStrokeThickness = 1.42,
		strokeTransparency = 0.08,
		hoverStrokeTransparency = 0.02,
		glowThickness = 2,
		hoverGlowThickness = 2.25,
		glowTransparency = 0.8,
		hoverGlowTransparency = 0.7,
		sheenHeight = 18,
		hoverSheenHeight = 20,
		sheenRotation = 18,
		sheenTopTransparency = 0.9,
		hoverSheenTopTransparency = 0.84,
	}),
	Epic = makeRarityStyle({
		textColor = Color3.fromRGB(220, 191, 255),
		borderColor = Color3.fromRGB(166, 111, 255),
		glowColor = Color3.fromRGB(190, 146, 255),
		gradientStart = Color3.fromRGB(223, 184, 255),
		gradientEnd = Color3.fromRGB(135, 86, 236),
		strokeThickness = 1.42,
		hoverStrokeThickness = 1.6,
		strokeTransparency = 0.05,
		hoverStrokeTransparency = 0.01,
		glowThickness = 2.55,
