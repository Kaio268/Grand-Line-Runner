			Movement = {
				WalkSpeedMultiplier = 0.9,
				JumpMultiplier = 1,
			},
		},
	},
}

function HitEffects.GetEffect(effectName)
	if typeof(effectName) ~= "string" or effectName == "" then
		return nil
	end

	return HitEffects.EffectsByName[effectName]
end

return HitEffects
]]></string>
