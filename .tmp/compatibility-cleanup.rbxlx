		gradientEnd = Color3.fromRGB(103, 120, 148),
		strokeThickness = 1,
		hoverStrokeThickness = 1.14,
		strokeTransparency = 0.22,
		hoverStrokeTransparency = 0.14,
		glowTransparency = 1,
		hoverGlowTransparency = 1,
		sheenTopTransparency = 1,
		hoverSheenTopTransparency = 1,
	}),
	Uncommon = makeRarityStyle({
		textColor = Color3.fromRGB(165, 248, 199),
