                <string name="Name">isValidElementType</string>
                <string name="Source"><![CDATA[-- ROBLOX upstream: https://github.com/facebook/react/blob/b61174fb7b09580c1ec2a8f55e73204b706d2935/packages/shared/isValidElementType.js
--[[*
