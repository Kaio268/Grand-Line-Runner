local imageObject = script.Parent
local serverLuck = workspace:WaitForChild("ServerLuck")

local images = {
	[2] = "rbxassetid://118518723004729",
	[4] = "rbxassetid://81862592925901",
	[8] = "rbxassetid://107262434211544",
