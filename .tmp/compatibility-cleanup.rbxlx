      <Item class="Script" referent="780">
        <Properties>
          <string name="Name">NoDisasters</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local timer = Workspace:WaitForChild("NoDisastersTimer")

local running = false

local function countdown()
	if running then return end
	running = true

	while timer.Value > 0 do
		task.wait(1)
		if timer.Value > 0 then
			timer.Value -= 1
		end
	end

	running = false
end

timer:GetPropertyChangedSignal("Value"):Connect(function()
	if timer.Value > 0 then
		countdown()
	end
end)

if timer.Value > 0 then
	countdown()
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="781">
        <Properties>
          <string name="Name">PlayerDeathAttributes</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")

local function hook(plr)
	plr:SetAttribute("IsDead", false)
	if plr:GetAttribute("CarriedBrainrot") == nil then
		plr:SetAttribute("CarriedBrainrot", nil)
	end

	local function onChar(char)
		plr:SetAttribute("IsDead", false)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			hum.Died:Connect(function()
				if plr and plr.Parent then
					plr:SetAttribute("IsDead", true)
					plr:SetAttribute("CarriedBrainrot", nil)
				end
			end)
		end
	end

	plr.CharacterAdded:Connect(onChar)
	if plr.Character then
		onChar(plr.Character)
	end
end

Players.PlayerAdded:Connect(hook)
for _, p in ipairs(Players:GetPlayers()) do
	hook(p)
end
