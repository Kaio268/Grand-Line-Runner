	HeaderTextStroke = Color3.fromRGB(17, 24, 33),
	SidebarFill = Color3.fromRGB(34, 49, 66),
	SidebarActive = Color3.fromRGB(58, 47, 18),
	SidebarActiveStroke = Color3.fromRGB(242, 209, 107),
	SidebarIndicator = Color3.fromRGB(212, 175, 55),
	TabFill = Color3.fromRGB(42, 58, 77),
	TabFillHover = Color3.fromRGB(58, 79, 103),
	TabRewardFill = Color3.fromRGB(58, 47, 18),
