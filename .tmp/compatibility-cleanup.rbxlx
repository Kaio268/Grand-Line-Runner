    <Item class="Script" referent="798">
      <Properties>
        <string name="Name">freereward</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local add = require(script.Parent.Modules.AddCrewMember)
local data = require(script.Parent.Data.DataManager)

local remote = ReplicatedStorage:FindFirstChild("RewardRemote")
if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "RewardRemote"
	remote.Parent = ReplicatedStorage
end

remote.OnServerEvent:Connect(function(player)
