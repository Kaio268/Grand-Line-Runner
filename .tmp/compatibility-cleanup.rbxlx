          <string name="Source"><![CDATA[local CrewQuickSlotService = require(game:GetService("ServerScriptService"):WaitForChild("Modules"):WaitForChild("CrewQuickSlotService"))

-- Compatibility bootstrap. CrewQuickSlots.server.lua is the Crew-named entry point.
CrewQuickSlotService.Init()
