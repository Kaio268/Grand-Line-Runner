		sheenHeight = 22,
		hoverSheenHeight = 25,
		sheenRotation = 24,
		sheenTopTransparency = 0.82,
		hoverSheenTopTransparency = 0.74,
	}),
	Legendary = makeRarityStyle({
		textColor = Color3.fromRGB(255, 229, 150),
		borderColor = Color3.fromRGB(255, 188, 83),
		glowColor = Color3.fromRGB(255, 204, 104),
		gradientStart = Color3.fromRGB(255, 230, 148),
		gradientEnd = Color3.fromRGB(235, 146, 62),
		strokeThickness = 1.58,
		hoverStrokeThickness = 1.8,
		strokeTransparency = 0.03,
		hoverStrokeTransparency = 0,
		glowThickness = 3.05,
		hoverGlowThickness = 3.45,
		glowTransparency = 0.66,
		hoverGlowTransparency = 0.54,
		sheenHeight = 26,
		hoverSheenHeight = 30,
		sheenRotation = 30,
		sheenTopTransparency = 0.74,
		hoverSheenTopTransparency = 0.66,
	}),
	Mythic = makeRarityStyle({
		textColor = Color3.fromRGB(255, 197, 152),
		borderColor = Color3.fromRGB(255, 124, 86),
		glowColor = Color3.fromRGB(255, 162, 98),
		gradientStart = Color3.fromRGB(255, 209, 144),
		gradientEnd = Color3.fromRGB(224, 102, 77),
		strokeThickness = 1.62,
		hoverStrokeThickness = 1.84,
		strokeTransparency = 0.02,
		hoverStrokeTransparency = 0,
		glowThickness = 3.15,
		hoverGlowThickness = 3.5,
		glowTransparency = 0.64,
		hoverGlowTransparency = 0.52,
		sheenHeight = 27,
		hoverSheenHeight = 31,
		sheenRotation = 30,
		sheenTopTransparency = 0.72,
		hoverSheenTopTransparency = 0.64,
	}),
	Godly = makeRarityStyle({
		textColor = Color3.fromRGB(255, 182, 214),
		borderColor = Color3.fromRGB(255, 96, 152),
		glowColor = Color3.fromRGB(255, 129, 173),
		gradientStart = Color3.fromRGB(255, 205, 223),
		gradientEnd = Color3.fromRGB(227, 80, 144),
		strokeThickness = 1.66,
		hoverStrokeThickness = 1.88,
		strokeTransparency = 0.02,
		hoverStrokeTransparency = 0,
		glowThickness = 3.2,
		hoverGlowThickness = 3.55,
		glowTransparency = 0.62,
		hoverGlowTransparency = 0.5,
		sheenHeight = 28,
		hoverSheenHeight = 32,
		sheenRotation = 32,
		sheenTopTransparency = 0.7,
		hoverSheenTopTransparency = 0.62,
	}),
	Secret = makeRarityStyle({
		textColor = Color3.fromRGB(217, 193, 255),
