          </Properties>
        </Item>
        <Item class="ModuleScript" referent="195">
          <Properties>
            <string name="Name">MeraVfx</string>
            <string name="Source"><![CDATA[return require(script.Parent:WaitForChild("Mera"):WaitForChild("Shared"):WaitForChild("Vfx"))
